#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=/dev/null
source "$ROOT/.ai-review/lib/common.sh" 2>/dev/null || source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/templates/lib/common.sh"

AI_SHOW_HELP=0
ai_parse_profile_args "$@"
if [[ "$AI_SHOW_HELP" == 1 ]]; then
  echo "Usage: ai-review-plan [base] [--profile fast|standard|strict]"; exit 0
fi
ai_require_git; ai_profile_limits; ai_collect_scope; ai_classify_risk; ai_contract_status

printf 'AI review plan\n'
printf '  profile:       %s\n' "$AI_PROFILE"
printf '  scope:         %s\n' "$AI_RANGE"
printf '  files:         %s\n' "$AI_FILE_COUNT"
printf '  changed lines: %s\n' "$AI_CHANGED_LINES"
printf '  risk:          %s\n' "$AI_RISK"
printf '  security:      %s\n' "$AI_SECURITY_BOUNDARY"
printf '  contract:      %s\n' "$AI_CONTRACT_STATUS"
printf '  context cap:   %s raw / %s review files\n' "$AI_MAX_FILES" "$AI_MAX_REVIEW_FILES"
printf '  agent budget:  %s calls / %s escalations / %s review rounds\n' "$AI_MAX_CALLS" "$AI_MAX_ESCALATIONS" "$AI_MAX_REVIEWS"
printf '  codegraph:     %s\n' "$(ai_codegraph_status)"
[[ -z "$AI_RISK_REASON" ]] || printf '  reason:        %s\n' "$AI_RISK_REASON"

echo
if [[ "$AI_CONTRACT_STATUS" != "present" && "$AI_RISK" != "LOW" ]]; then
  echo "Gate: create/complete .ai-review/current-contract.yml before non-trivial implementation."
  echo "      Run: ./bin/ai-contract init"
  echo
fi

case "$AI_RISK" in
  LOW)
    cat <<'MSG'
Routing:
  Builder: Sonnet (Haiku only for truly mechanical work)
  Regression: Haiku if behavior changed
  Codex: skip by default
  Cleanup: Haiku
  Ponytail: Sonnet

Action:
  Run targeted deterministic checks, Cleanup, checks again, then Ponytail.
MSG
    ;;
  MEDIUM)
    cat <<MSG
Routing:
  Builder: Sonnet
  Regression: Haiku, max 3 concrete risks
  Codex: Terra reviewer
  Cleanup: Haiku
  Ponytail: Sonnet

Context:
  Diff first. Use CodeGraph blast radius before raw file expansion.

Recommended review:
/codex:adversarial-review --base $AI_BASE --background focus on correctness, regressions, backwards compatibility and concrete edge cases; confidence >= 0.80 unless high-impact; return at most 5 findings; no style or broad rewrites
MSG
    ;;
  HIGH)
    cat <<MSG
Routing:
  Planner: Opus when strategy is non-obvious
  Builder: Sonnet
  Regression: Haiku
  Codex: Sol reviewer
  Security gate: $( [[ "$AI_SECURITY_BOUNDARY" == true ]] && echo required || echo conditional/not detected )
  Cleanup: Haiku
  Ponytail: Sonnet

Context:
  Use CodeGraph callers/callees + blast radius. Full suite is recommended for strict/high-risk work.

Recommended review:
/codex:adversarial-review --base $AI_BASE --background focus on security/auth, data integrity, races, retries/idempotency, rollback, backwards compatibility and concrete failure modes; return at most 5 findings with evidence; no style or speculative rewrites

Stop conditions:
  Unresolved destructive/security/architecture tradeoff -> NEEDS_HUMAN, not infinite escalation.
MSG
    ;;
esac
