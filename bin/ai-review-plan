#!/usr/bin/env bash
set -euo pipefail

BASE="${1:-main}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Not inside a git repository." >&2
  exit 1
fi

if git rev-parse --verify "$BASE" >/dev/null 2>&1; then
  RANGE="$BASE...HEAD"
  FILES="$(git diff --name-only "$RANGE" 2>/dev/null || true)"
  NUMSTAT="$(git diff --numstat "$RANGE" 2>/dev/null || true)"
else
  RANGE="working tree"
  FILES="$(git diff --name-only HEAD 2>/dev/null || true)"
  NUMSTAT="$(git diff --numstat HEAD 2>/dev/null || true)"
fi

UNTRACKED="$(git ls-files --others --exclude-standard || true)"
if [[ -n "$UNTRACKED" ]]; then
  FILES="${FILES}${FILES:+$'\n'}${UNTRACKED}"
fi

FILES="$(printf '%s\n' "$FILES" | grep -Ev '^(\.ai-review/|CLAUDE\.md$|AGENTS\.md$|bin/ai-review-plan$)' || true)"
FILE_COUNT=$(printf '%s\n' "$FILES" | sed '/^$/d' | wc -l | tr -d ' ')
CHANGED_LINES=$(printf '%s\n' "$NUMSTAT" | awk '{a+=$1; d+=$2} END {print a+d+0}')

RISK="LOW"
REASONS=()
HIGH_PATTERN='(^|/)(auth|authentication|authorization|rbac|iam|payment|payments|billing|migration|migrations|schema|database|db|crypto|secrets?|permissions?|infra|terraform|k8s|kubernetes)(/|$)|(^|/)(Dockerfile|.*\.tf|.*\.sql)$'
MEDIUM_PATTERN='(^|/)(api|services?|integrations?|workers?|queues?|jobs?|repositories?|controllers?|middleware)(/|$)'
LOW_ONLY_PATTERN='(^|/)(docs?|examples?|fixtures?|snapshots?)(/|$)|\.(md|txt|snap)$'

if printf '%s\n' "$FILES" | grep -Eqi "$HIGH_PATTERN"; then
  RISK="HIGH"
  REASONS+=("high-risk path/domain")
fi

if [[ "$RISK" != "HIGH" ]] && printf '%s\n' "$FILES" | grep -Eqi "$MEDIUM_PATTERN"; then
  RISK="MEDIUM"
  REASONS+=("business/API/integration path")
fi

# Diff size is only a weak signal. It can promote LOW -> MEDIUM, but never MEDIUM -> HIGH.
if [[ "$RISK" == "LOW" && ( "$CHANGED_LINES" -ge 160 || "$FILE_COUNT" -ge 6 ) ]]; then
  if [[ -n "$FILES" ]] && ! printf '%s\n' "$FILES" | grep -Evqi "$LOW_ONLY_PATTERN"; then
    RISK="MEDIUM"
    REASONS+=("non-trivial diff size")
  fi
fi

printf 'AI review plan\n'
printf '  scope:         %s\n' "$RANGE"
printf '  files:         %s\n' "$FILE_COUNT"
printf '  changed lines: %s\n' "$CHANGED_LINES"
printf '  risk:          %s\n' "$RISK"
if ((${#REASONS[@]})); then
  printf '  reason:        %s\n' "$(IFS=', '; echo "${REASONS[*]}")"
fi

if command -v codegraph >/dev/null 2>&1; then
  if codegraph status . >/dev/null 2>&1; then
    echo "  codegraph:     ready"
  else
    echo "  codegraph:     installed, project not initialized"
  fi
else
  echo "  codegraph:     unavailable"
fi

echo
case "$RISK" in
  LOW)
    cat <<'MSG'
Routing:
  Claude: Haiku for mechanical-only work; otherwise Sonnet.
  Codex:  skip by default.

Action:
  Run relevant tests/lint/typecheck and finish.
MSG
    ;;
  MEDIUM)
    cat <<MSG
Routing:
  Claude: Sonnet default builder.
  Codex:  Terra reviewer.

Before review:
  Use CodeGraph for blast radius if behavior crosses files/services.

Recommended Claude Code command:
/codex:adversarial-review --base $BASE --background focus on correctness, regressions, backwards compatibility and concrete edge cases; return at most 5 findings with severity, confidence, file/location and failure scenario; no style, broad rewrites or speculative issues
MSG
    ;;
  HIGH)
    cat <<MSG
Routing:
  Claude: Opus for strategy/deep reasoning when needed, Sonnet for implementation.
  Codex:  Sol reviewer.

Before review:
  Use CodeGraph to inspect callers/callees and blast radius. Do not crawl the repo broadly.

Recommended Claude Code command:
/codex:adversarial-review --base $BASE --background focus on security/auth, data integrity, races, retries/idempotency, rollback, backwards compatibility and concrete failure modes; return at most 5 findings with severity, confidence, file/location and failure scenario; no style, broad rewrites or speculative issues

Second pass:
  Only after a confirmed HIGH/CRITICAL issue or when the correction changes a high-risk invariant.
MSG
    ;;
esac
