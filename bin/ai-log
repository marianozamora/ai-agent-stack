#!/usr/bin/env python3
import json, pathlib, subprocess, sys, time, os
if len(sys.argv) < 4:
    print('Usage: ai-log <phase> <model-or-tool> <status> [note]', file=sys.stderr); sys.exit(2)
root=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())
out=root/'.ai-review/telemetry.jsonl'; out.parent.mkdir(exist_ok=True)
row={'ts':int(time.time()),'phase':sys.argv[1],'actor':sys.argv[2],'status':sys.argv[3]}
if len(sys.argv)>4: row['note']=' '.join(sys.argv[4:])[:500]
for env,key in [('AI_INPUT_TOKENS','input_tokens'),('AI_OUTPUT_TOKENS','output_tokens'),('AI_CACHED_TOKENS','cached_tokens')]:
    if os.getenv(env,'').isdigit(): row[key]=int(os.getenv(env))
with out.open('a') as f: f.write(json.dumps(row,separators=(',',':'))+'\n')
print('logged')
