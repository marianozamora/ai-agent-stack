#!/usr/bin/env bash
set -euo pipefail
check() {
  local name="$1" cmd="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    local version; version="$($cmd --version 2>/dev/null | head -n1 || true)"
    printf '✓ %-12s %s\n' "$name" "${version:-installed}"
  else printf '✗ %-12s missing\n' "$name"; fi
}
echo "AI Agent Stack doctor"
check "git" git
check "python3" python3
check "node" node
check "claude" claude
check "codex" codex
check "rtk" rtk
check "codegraph" codegraph

echo
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  [[ -f .ai-review/current-contract.yml ]] && echo "✓ PR contract present" || echo "· PR contract not created yet"
  [[ -f .ai-review/project-profile.json ]] && echo "✓ project profile present" || echo "· project profile missing: run ./bin/ai-project-profile"
  if command -v codegraph >/dev/null 2>&1; then codegraph status . >/dev/null 2>&1 && echo "✓ CodeGraph ready" || echo "· CodeGraph not initialized"; fi
  [[ -x ./bin/ai-figma ]] && ./bin/ai-figma doctor || true
fi

if command -v rtk >/dev/null 2>&1; then
  echo; echo "RTK savings snapshot:"; rtk gain 2>/dev/null | head -n 12 || true
fi

echo
cat <<'MSG'
Per-project:
  ./bin/ai status
  ./bin/ai-contract status
  ./bin/ai-project-profile
  ./bin/ai-check-plan
  ./bin/ai-review-plan main --profile standard
  ./bin/ai-pr-ready main --profile standard
  ./bin/ai-provenance-scan main
  ./bin/ai-metrics
MSG
