#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
TEMPLATE="$ROOT/.ai-review/contracts/pr-contract.yml"
TARGET="$ROOT/.ai-review/current-contract.yml"
CMD="${1:-status}"
case "$CMD" in
  init)
    [[ -f "$TEMPLATE" ]] || { echo "Missing template: $TEMPLATE" >&2; exit 1; }
    if [[ -f "$TARGET" ]]; then echo "Contract already exists: $TARGET"; exit 0; fi
    cp "$TEMPLATE" "$TARGET"
    echo "Created $TARGET"
    echo "Fill objective, acceptance, must_not_change, risk and test_plan before non-trivial work."
    ;;
  reset)
    [[ -f "$TEMPLATE" ]] || exit 1
    cp "$TEMPLATE" "$TARGET"; echo "Reset $TARGET"
    ;;
  status)
    if [[ ! -f "$TARGET" ]]; then echo "PR_CONTRACT: MISSING"; exit 1; fi
    if grep -Eq '^objective:[[:space:]]*""[[:space:]]*$|^[[:space:]]*-[[:space:]]*""[[:space:]]*$|^risk:[[:space:]]*unknown[[:space:]]*$' "$TARGET"; then
      echo "PR_CONTRACT: INCOMPLETE"; exit 2
    fi
    echo "PR_CONTRACT: PRESENT"
    ;;
  show) cat "$TARGET" ;;
  *) echo "Usage: ai-contract init|status|show|reset" >&2; exit 2 ;;
esac
