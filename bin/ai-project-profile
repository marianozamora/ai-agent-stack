#!/usr/bin/env python3
import json, pathlib, subprocess, sys
try:
    root = pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip())
except Exception:
    print('Not inside a git repository.', file=sys.stderr); sys.exit(1)

ext_map={'.ts':'TypeScript','.tsx':'TypeScript/React','.js':'JavaScript','.jsx':'JavaScript/React','.py':'Python','.java':'Java','.kt':'Kotlin','.go':'Go','.rs':'Rust','.rb':'Ruby','.php':'PHP','.cs':'C#','.swift':'Swift'}
try:
    rels=subprocess.check_output(['git','ls-files','--cached','--others','--exclude-standard'], cwd=root, text=True).splitlines()
except Exception:
    rels=[]
counts={}
for rel in rels:
    p=root/rel
    if p.suffix in ext_map: counts[ext_map[p.suffix]]=counts.get(ext_map[p.suffix],0)+1
langs=[k for k,_ in sorted(counts.items(),key=lambda kv:kv[1],reverse=True)[:8]]

def existing(names): return [n for n in names if (root/n).exists()]
package_managers=[]
for lock,name in [('pnpm-lock.yaml','pnpm'),('yarn.lock','yarn'),('package-lock.json','npm'),('bun.lockb','bun'),('poetry.lock','poetry'),('uv.lock','uv'),('Pipfile.lock','pipenv'),('go.mod','go'),('Cargo.toml','cargo')]:
    if (root/lock).exists(): package_managers.append(name)
formatters=existing(['.prettierrc','.prettierrc.json','prettier.config.js','prettier.config.mjs','biome.json','biome.jsonc','rustfmt.toml'])
linters=existing(['eslint.config.js','eslint.config.mjs','eslint.config.ts','.eslintrc','.eslintrc.json','biome.json','biome.jsonc','ruff.toml','.ruff.toml','pyproject.toml','checkstyle.xml'])
typecheckers=existing(['tsconfig.json','pyrightconfig.json','mypy.ini','pyproject.toml'])
tests=existing(['vitest.config.ts','vitest.config.js','jest.config.js','jest.config.ts','playwright.config.ts','pytest.ini','tox.ini'])
style_sources=existing(['CONTRIBUTING.md','STYLE.md','ARCHITECTURE.md','CLAUDE.md','AGENTS.md'])
arch_docs=[x for x in style_sources if 'ARCHITECTURE' in x]
docs=root/'docs'
if docs.exists():
    arch_docs += [str(p.relative_to(root)) for p in docs.iterdir() if p.is_file() and 'architecture' in p.name.lower()]
paradigm=[]
if any(x.startswith('TypeScript') or x.startswith('JavaScript') for x in langs): paradigm.append('infer-from-nearby-modules; do not assume OO or FP globally')
if {'Java','C#','Kotlin'} & set(langs): paradigm.append('OO/service patterns may be present; verify locally')
profile={'version':1,'generated':True,'languages':langs,'language_file_counts':counts,'package_managers':package_managers,'formatters':formatters,'linters':linters,'typecheckers':typecheckers,'test_frameworks':tests,'architecture_docs':arch_docs,'style_sources':style_sources,'paradigm_hints':paradigm,'notes':['Generated profile is evidence, not dogma. Explicit repository guidance and nearby code take precedence.']}
out=root/'.ai-review/project-profile.json'; out.parent.mkdir(exist_ok=True); out.write_text(json.dumps(profile,indent=2)+"\n")
print(f'Wrote {out}')
print('Languages:', ', '.join(langs) or 'unknown')
