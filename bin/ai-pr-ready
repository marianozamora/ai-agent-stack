#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=/dev/null
source "$ROOT/.ai-review/lib/common.sh" 2>/dev/null || source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/templates/lib/common.sh"
AI_SHOW_HELP=0; ai_parse_profile_args "$@"
ai_require_git; ai_profile_limits; ai_collect_scope; ai_classify_risk; ai_contract_status

cat <<MSG
AI PR-readiness pipeline
  profile:  $AI_PROFILE
  scope:    $AI_RANGE
  risk:     $AI_RISK
  security: $AI_SECURITY_BOUNDARY
  contract: $AI_CONTRACT_STATUS

Gates:
  1. PR Contract satisfied
  2. Context Governor respected ($AI_MAX_FILES raw / $AI_MAX_REVIEW_FILES review files)
  3. Relevant deterministic checks pass
  4. Regression scout resolved
  5. Risk-based Codex correctness review resolved (MEDIUM+; profile permitting)
  6. Conditional security gate resolved when required
  7. Snapshot diff: ./bin/ai-diff-budget snapshot
  8. Cleanup agent (Haiku; behavior-neutral only)
  9. Cleanup diff budget: ./bin/ai-diff-budget check
 10. Relevant checks pass again
 11. Ponytail (Sonnet; read-only final quality gate)
 12. If Ponytail FAILS: one targeted builder fix loop only
 13. PR Summarizer (Haiku) reads final artifacts only

PR_READY requires:
  ✓ contract satisfied
  ✓ checks pass
  ✓ no unresolved HIGH/CRITICAL correctness issue
  ✓ security gate PASS or not required
  ✓ CLEANUP: PASS and diff budget PASS
  ✓ PONYTAIL: PASS

Circuit breakers:
  max agent calls: $AI_MAX_CALLS
  max escalations: $AI_MAX_ESCALATIONS
  max review rounds: $AI_MAX_REVIEWS
  unresolved high-impact issue after budget => NEEDS_HUMAN

Specs:
  .ai-review/agents/regression.md
  .ai-review/agents/security-gate.md
  .ai-review/agents/cleanup.md
  .ai-review/agents/ponytail.md
  .ai-review/agents/pr-summarizer.md
MSG
